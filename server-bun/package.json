{
  "name": "instantbox-k8s-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#jsx/jsx-runtime": "./src/frontend/jsx-runtime.ts",
    "#jsx/jsx-dev-runtime": "./src/frontend/jsx-runtime.ts",
    "#frontend/*": "./src/frontend/*.ts",
    "#frontend/*.tsx": "./src/frontend/*.tsx"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
